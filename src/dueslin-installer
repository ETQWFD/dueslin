def log(msg):
    print(f"[INSTALLER] {msg}", flush=True)
    try:
        with open("/tmp/dueslin-install.log", "a") as f:
            f.write(f"{time.strftime('%H:%M:%S')} {msg}\n")
    except Exception:
        pass

def run(cmd):
    log("$ " + cmd)
    return subprocess.run(cmd, shell=True, capture_output=True, text=True)

# ---------------------------------------------------------------- 磁盘工具
def list_disks():
    """返回磁盘列表 [{name,size,model,type,path}] — 纯 Python 扫 /sys/block，零外部依赖"""
    out = []
    try:
        for name in sorted(os.listdir("/sys/block")):
            if name.startswith(("loop", "ram", "sr", "fd", "dm-", "zram")):
                continue
            path = f"/dev/{name}"
            if not os.path.exists(path):
                continue
            size = "?"
            try:
                with open(f"/sys/block/{name}/size") as f:
                    s512 = int(f.read().strip())
                size = f"{s512 * 512 / (1024**3):.1f}G"
            except Exception:
                pass
            model = ""
            for m in ("device/model", "device/vendor"):
                try:
                    with open(f"/sys/block/{name}/{m}") as f:
                        model += f.read().strip() + " "
                except Exception:
                    pass
            model = model.strip() or "硬盘"
            if name.startswith("vd"):
                model = "VirtIO 磁盘 " + model
            out.append({"name": name, "size": size, "model": model, "path": path})
    except Exception as e:
        log(f"磁盘扫描失败: {e}")
    if not out:
        log("警告: 未扫描到任何磁盘")
    return out

def get_uuid(dev):
    r = run(f"blkid -s UUID -o value {dev}")
    return r.stdout.strip()

# ---------------------------------------------------------------- 安装核心
class Installer:
    def __init__(self, disk=None, partition=None):
        self.disk = disk          # 整盘安装时: /dev/sda
        self.partition = partition  # 自定义分区: /dev/sda1
        self.target_root = None
        self.esp = None
        self.wim_path = None
        self.mounted = []
        self.log_text = ""

    def resolve_wim(self):
        """定位安装介质上的 DUESLIN.wim（支持 SRC 标记 / 光驱 / 磁盘自动扫描）"""
        import glob
        if os.path.exists(SRC_MARKER):
            dev = open(SRC_MARKER).read().strip()
            mnt = "/media/src"
            os.makedirs(mnt, exist_ok=True)
            try:
                if not os.path.ismount(mnt):
                    run(f"mount {dev} {mnt} -o ro")
                if os.path.exists(f"{mnt}/boot/dueslin/DUESLIN.wim"):
                    self.wim_path = f"{mnt}/boot/dueslin/DUESLIN.wim"
                    return self.wim_path
            except Exception:
                pass
            try:
                run(f"umount {mnt}")
            except Exception:
                pass
        # 自动扫描光驱与磁盘，找到安装源
        mnt = "/media/src"
        os.makedirs(mnt, exist_ok=True)
        for dev in glob.glob("/dev/sr[0-9]*") + glob.glob("/dev/sd[a-z]*"):
            try:
                if not os.path.ismount(mnt):
                    run(f"mount {dev} {mnt} -o ro")
                w = f"{mnt}/boot/dueslin/DUESLIN.wim"
                if os.path.exists(w):
                    self.wim_path = w
                    return w
            except Exception:
                pass
            try:
                run(f"umount {mnt}")
            except Exception:
                pass
        for p in ["/boot/dueslin/DUESLIN.wim", "/mnt/src/boot/dueslin/DUESLIN.wim",
                  "/media/src/boot/dueslin/DUESLIN.wim"]:
            if os.path.exists(p):
                self.wim_path = p
                return p
        return None

    def partition_disk(self):
        """整盘 GPT: 1M bios_grub + 512M ESP + 剩余 ext4"""
        log(f"分区 {self.disk} ...")
        run(f"wipefs -a {self.disk}")
        run(f"parted -s {self.disk} mklabel gpt")
        run(f"parted -s {self.disk} mkpart primary 1MiB 2MiB")
        run(f"parted -s {self.disk} set 1 bios_grub on")
        run(f"parted -s {self.disk} mkpart primary fat32 2MiB 514MiB")
        run(f"parted -s {self.disk} set 2 esp on")
        run(f"parted -s {self.disk} mkpart primary ext4 514MiB 100%")
        run("partprobe " + self.disk)
        time.sleep(3)
        # 根据磁盘类型解析分区节点
        base = self.disk
        if re.match(r"/dev/(sd|vd|hd)", base):
            self.esp = f"{base}2"; self.target_root = f"{base}3"
        elif re.match(r"/dev/nvme", base):
            self.esp = f"{base}p2"; self.target_root = f"{base}p3"
        elif re.match(r"/dev/mmcblk", base):
            self.esp = f"{base}p2"; self.target_root = f"{base}p3"
        else:
            self.esp = f"{base}2"; self.target_root = f"{base}3"
        log(f"格式化: {self.esp} (FAT32) / {self.target_root} (ext4)")
        run(f"mkfs.vfat -F32 -n DUESLIN_BOOT {self.esp}")
        run(f"mkfs.ext4 -F -L DUESLIN {self.target_root}")

    def prepare_custom(self):
        self.target_root = self.partition
        log(f"自定义分区: {self.target_root} -> ext4")
        run(f"mkfs.ext4 -F -L DUESLIN {self.target_root}")

    def install(self, progress_cb, log_cb):
        """执行安装，progress_cb(percent), log_cb(text)"""
        log_cb("准备磁盘 ...")
        if self.disk:
            self.partition_disk()
        else:
            self.prepare_custom()

        # 挂载目标
        os.makedirs("/mnt/target", exist_ok=True)
        run(f"mount {self.target_root} /mnt/target")
        self.mounted.append("/mnt/target")
        if self.esp:
            os.makedirs("/mnt/target/boot", exist_ok=True)
            run(f"mount {self.esp} /mnt/target/boot")
            self.mounted.append("/mnt/target/boot")

        # 解压 WIM
        wim = self.resolve_wim()
        if not wim:
            raise RuntimeError("找不到 DUESLIN.wim 安装源")
        log_cb(f"正在解压系统镜像: {wim}")
        log_cb("（WIM 压缩包解压复制中，请耐心等待）")

        proc = subprocess.Popen(
            ["wimlib-imagex", "apply", wim, "1", "/mnt/target", "--unix-data"],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1)
        proc.wait()
        if proc.returncode != 0:
            err = (proc.stdout.read() if proc.stdout else "")[:300]
            raise RuntimeError(f"WIM 解压失败: {err}")
        progress_cb(50)
        # 确保系统虚拟目录存在（WIM 捕获时已清空，解压后重建）
        for d in ("dev", "proc", "sys", "run", "tmp", "mnt", "media"):
            os.makedirs(f"/mnt/target/{d}", exist_ok=True)

        # fstab
        log_cb("写入系统配置 ...")
        root_uuid = get_uuid(self.target_root)
        fstab = f"UUID={root_uuid} / ext4 defaults,noatime 0 1\n"
        if self.esp:
            esp_uuid = get_uuid(self.esp)
            fstab += f"UUID={esp_uuid} /boot vfat defaults 0 2\n"
        with open("/mnt/target/etc/fstab", "w") as f:
            f.write(fstab)
        progress_cb(55)

        # 复制 PE 修复环境到 /boot/pe
        log_cb("复制 PE 修复环境 ...")
        pe_src = None
        if os.path.exists("/boot/vmlinuz-lts") and os.path.exists("/boot/dueslin-initramfs"):
            pe_src = self.find_live_squashfs()
            os.makedirs("/mnt/target/boot/pe", exist_ok=True)
            shutil.copy("/boot/vmlinuz-lts", "/mnt/target/boot/pe/vmlinuz")
            shutil.copy("/boot/dueslin-initramfs", "/mnt/target/boot/pe/initramfs")
            if pe_src:
                shutil.copy(pe_src, "/mnt/target/boot/pe/pe.squashfs")
        progress_cb(70)

        # 复制系统内核与 initramfs 到引导目录（/boot/dueslin/）
        # 内核源优先取 ISO 挂载点（live squashfs 不含 boot，ISO 层含 /boot/dueslin/）
        log_cb("复制系统内核 ...")
        os.makedirs("/mnt/target/boot/dueslin", exist_ok=True)
        # 内核源：与 WIM 同目录（/media/src/boot/dueslin/），最可靠
        wim_dir = os.path.dirname(wim) if 'wim' in dir() and wim else "/media/src/boot/dueslin"
        kern_src = os.path.join(wim_dir, "vmlinuz")
        init_src = os.path.join(wim_dir, "initramfs")
        log(f"  内核源检查: {kern_src} exists={os.path.exists(kern_src)}, {init_src} exists={os.path.exists(init_src)}")
        if os.path.exists(kern_src) and os.path.exists(init_src):
            shutil.copy(kern_src, "/mnt/target/boot/dueslin/vmlinuz")
            shutil.copy(init_src, "/mnt/target/boot/dueslin/initramfs")
            log(f"  ✓ 内核已复制: /mnt/target/boot/dueslin/vmlinuz + initramfs")
        else:
            # 兜底：扫描所有挂载点
            for base in ("/media/src", "/mnt/src", "/run/media", "/media"):
                k = os.path.join(base, "boot/dueslin/vmlinuz")
                i = os.path.join(base, "boot/dueslin/initramfs")
                if os.path.exists(k) and os.path.exists(i):
                    shutil.copy(k, "/mnt/target/boot/dueslin/vmlinuz")
                    shutil.copy(i, "/mnt/target/boot/dueslin/initramfs")
                    log(f"  ✓ 兜底复制内核: {base}")
                    break
            else:
                log("  ✗ 内核源缺失（检查 ISO 的 /boot/dueslin/vmlinuz）")

        # 安装 GRUB
        log_cb("安装引导程序 ...")
        grub_dir = "/mnt/target/boot/grub"
        os.makedirs(grub_dir, exist_ok=True)
        efi = os.path.isdir("/sys/firmware/efi")
        def _grub(cmd):
            rc = run(cmd)
            if rc.returncode != 0:
                raise RuntimeError(f"grub-install 失败: {(rc.stderr or '')[:200]}")
        if self.disk:
            if efi:
                _grub(f"grub-install --target=x86_64-efi --efi-directory=/mnt/target/boot "
                      f"--boot-directory=/mnt/target/boot --removable --recheck")
            else:
                _grub(f"grub-install --target=i386-pc --boot-directory=/mnt/target/boot "
                      f"--recheck {self.disk}")
        else:
            # 自定义分区：找到其所属磁盘
            disk = re.sub(r"p?\d+$", "", self.partition)
            _grub(f"grub-install --target=i386-pc --boot-directory=/mnt/target/boot --recheck {disk}")
        # grub.cfg
        tpl = "/etc/dueslin/grub.cfg.template"
        if os.path.exists(tpl):
            cfg = open(tpl).read().replace("__ROOT__", self.target_root)
            cfg = cfg.replace("__PE_ENTRY__", "")
            with open(f"{grub_dir}/grub.cfg", "w") as f:
                f.write(cfg)
        progress_cb(85)

        # 首启标记
        os.makedirs("/mnt/target/etc/dueslin", exist_ok=True)
        open("/mnt/target/etc/dueslin/.firstboot", "w").write("1\n")
        progress_cb(90)

        # 卸载
        log_cb("清理并卸载 ...")
        for m in reversed(self.mounted):
            run(f"umount {m} 2>/dev/null")
        self.mounted = []
        progress_cb(100)
        log_cb("安装完成！")

    def find_live_squashfs(self):
        # 优先读 /run/dueslin_src（旧 initramfs 兼容）
        if os.path.exists("/run/dueslin_src"):
            dev = open("/run/dueslin_src").read().strip()
            mnt = "/media/src"
            os.makedirs(mnt, exist_ok=True)
            if not os.path.ismount(mnt):
                run(f"mount {dev} {mnt} -o ro")
            p = f"{mnt}/boot/dueslin/live.squashfs"
            if os.path.exists(p):
                return p
        # 兼容已挂载点
        for p in ["/mnt/src/boot/dueslin/live.squashfs",
                  "/media/src/boot/dueslin/live.squashfs"]:
            if os.path.exists(p):
                return p
        # 兜底：扫描所有块设备找安装介质（ISO U盘 / 硬盘上的镜像）
        mnt = "/media/dueslin_src"
        os.makedirs(mnt, exist_ok=True)
        devs = []
        for pat in ["/dev/sr[0-9]*", "/dev/sd[a-z]*", "/dev/vd[a-z]*",
                    "/dev/nvme[0-9]n[0-9]*p[0-9]*", "/dev/mmcblk*p*"]:
            try:
                import glob
                devs.extend(glob.glob(pat))
            except Exception:
                pass
        for dev in devs:
            for fs in ["iso9660", "vfat", "ext4"]:
                rc = subprocess.run(f"mount -t {fs} -o ro {dev} {mnt} 2>/dev/null",
                                   shell=True, capture_output=True)
                if rc.returncode != 0:
                    continue
                p = f"{mnt}/boot/dueslin/live.squashfs"
                if os.path.exists(p):
                    return p
                subprocess.run(f"umount {mnt} 2>/dev/null", shell=True,
                               capture_output=True)
        return None

