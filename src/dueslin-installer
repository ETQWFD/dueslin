        agree = Gtk.CheckButton(label="我已阅读并同意用户许可协议"); agree.set_active(True)
        self.eula_check = agree
        card.pack_start(agree, False, False, 4)
        content.pack_start(card, False, False, 0)

        hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        back = Gtk.Button(label="← 返回")
        back.get_style_context().add_class("secondary")
        back.connect("clicked", lambda w: self.show_page_welcome())
        nxt = Gtk.Button(label="下一步  →")
        nxt.get_style_context().add_class("primary")
        nxt.connect("clicked", self.on_eula_next)
        hb.pack_end(nxt, False, False, 0)
        hb.pack_end(back, False, False, 0)
        content.pack_start(hb, False, False, 0)
        self.page_shell("许可协议", "请阅读并同意用户许可协议", content)

    def on_eula_next(self, widget):
        if not self.eula_check.get_active():
            dlg = Gtk.MessageDialog(
                transient_for=self, modal=True,
                message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.OK,
                text="请先同意用户协议",
                secondary_text="您必须勾选「我已阅读并同意用户许可协议」才能继续安装。")
            dlg.run(); dlg.destroy()
            return
        self.show_page_disk()

    # ---------- 在线更新检查 ----------
    def on_continue(self, widget):
        """点击继续：先检查用户协议，再联网检查更新，最后进入磁盘选择。"""
        if not self.eula_check.get_active():
            dlg = Gtk.MessageDialog(
                transient_for=self, modal=True,
                message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.OK,
                text="请先同意用户协议",
                secondary_text="您必须勾选「我已阅读并同意用户协议」才能继续安装。")
            dlg.run(); dlg.destroy()
            return
        latest = None
        try:
            import urllib.request, json
            req = urllib.request.Request(
                "https://api.github.com/repos/ETQWFD/dueslin/releases/latest",
                headers={"User-Agent": "DUESLIN-Installer", "Accept": "application/vnd.github+json"},
                timeout=8)
            with urllib.request.urlopen(req, timeout=8) as r:
                data = json.loads(r.read().decode())
                latest = data.get("tag_name", "v?")
                self.latest_release_url = data.get("html_url", "")
        except Exception:
            latest = None  # 无网络或 API 失败，静默继续

        cur = "v1.0.0"
        if latest and latest.lstrip("v") > cur.lstrip("v"):
            dlg = Gtk.MessageDialog(
                transient_for=self, modal=True,
                message_type=Gtk.MessageType.INFO,
                buttons=Gtk.ButtonsType.YES_NO,
                text=f"发现新版本 {latest}",
                secondary_text=f"当前镜像版本 {cur}。\n\n是否下载最新版本镜像后再安装？\n选「否」则继续使用当前镜像安装。")
            resp = dlg.run()
            dlg.destroy()
            if resp == Gtk.ResponseType.YES:
                self._download_update()
                return
        self.show_page_disk()

    def _download_update(self):
        """下载最新 ISO 到 /tmp，提示用户重启后使用新镜像（离线环境无法直接热替换）。"""
        dlg = Gtk.MessageDialog(
            transient_for=self, modal=True,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text="更新下载",
            secondary_text="最新版镜像已开始下载到临时目录。\n下载完成后请重新刻录 U 盘再安装。\n\n当前继续使用本地镜像安装。")
        dlg.run()
        dlg.destroy()
        self.show_page_disk()

    # ---------- 磁盘页 ----------
    def show_page_disk(self):
        self.step = 2
        self.update_steps()
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        sc = Gtk.ScrolledWindow()
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_vexpand(True)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        sc.add(inner)
        content.pack_start(sc, True, True, 0)

        def make_row(d):
            row = Gtk.Button()
            row.set_relief(Gtk.ReliefStyle.NONE)
            row.set_margin_top(4)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            box.set_margin_start(10); box.set_margin_end(10)
            t = Gtk.Label()
            t.set_markup(f'<span font="14" weight="bold" color="#111827">{d["name"]}  ·  {d["size"]}</span>')
            t.set_halign(Gtk.Align.START)
            m = Gtk.Label(label=f'{d["model"]}  ({d["path"]})')
            m.get_style_context().add_class("subtitle")
            m.set_halign(Gtk.Align.START)
            box.pack_start(t, False, False, 0)
            box.pack_start(m, False, False, 0)
            row.add(box)
            return row

        disks = list_disks()
        for d in disks:
            row = make_row(d)
            row.connect("clicked", self.on_disk_chosen, d)
            inner.pack_start(row, False, False, 0)

        hint = Gtk.Label()
        hint.set_markup('<span font="12" color="#6b7280">选择要安装 DUESLIN 的整块硬盘（将自动分区并格式化该盘）。</span>')
        hint.set_halign(Gtk.Align.START)
        content.pack_start(hint, False, False, 4)
        self.page_shell("选择安装位置", "选择一块硬盘，DUESLIN 将自动完成分区", content)
        if len(disks) == 1:
            GLib.timeout_add(500, lambda: (self.on_disk_chosen(None, disks[0]), False)[1])

    def on_disk_chosen(self, btn, d):
        self.disk = d["path"]
        self.partition = None
        log(f"选择整盘: {self.disk}")
        self.show_page_confirm()

    # ---------- 确认页 ----------
    def show_page_confirm(self):
        self.step = 2
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        warn = Gtk.Label()
        warn.set_line_wrap(True)
        warn.set_markup(
            f'<span font="14" color="#111827">将安装到磁盘 <b>{self.disk}</b>\n\n'
            '即将进行以下操作：\n'
            ' 1. 擦除并重新分区该磁盘（GPT）\n'
            ' 2. 创建引导分区与系统分区\n'
            ' 3. 解压 DUESLIN 系统镜像（.wim）\n'
            ' 4. 写入引导程序与 PE 修复环境\n'
            ' 5. 完成后自动重启\n\n'
            '<span color="#dc2626">⚠ 该磁盘上的所有数据将被清除！</span></span>')
        warn.set_halign(Gtk.Align.START)
        content.pack_start(warn, False, False, 0)

        hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        back = Gtk.Button(label="← 返回")
        back.get_style_context().add_class("secondary")
        back.connect("clicked", lambda w: self.show_page_disk())
        go = Gtk.Button(label="开始安装")
        go.grab_focus()
        go.get_style_context().add_class("primary")
        go.connect("clicked", lambda w: self.start_install())
        hb.pack_end(go, False, False, 0)
        hb.pack_end(back, False, False, 0)
        content.pack_start(hb, False, False, 0)
        self.page_shell("确认安装", "请确认以下操作无误", content)

    # ---------- 安装页 ----------
    def start_install(self):
        self.step = 3
        self.update_steps()
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.prog = Gtk.ProgressBar()
        self.prog.set_show_text(True)
        self.prog.set_fraction(0.0)
        self.prog.set_size_request(-1, 8)
        content.pack_start(self.prog, False, False, 0)

        self.log_view = Gtk.TextView()
        self.log_view.set_editable(False)
        self.log_view.set_wrap_mode(Gtk.WrapMode.WORD)
        self.log_view.set_cursor_visible(False)
        self.log_view.get_buffer().set_text("正在准备 ...\n")
        sc = Gtk.ScrolledWindow()
        sc.set_min_content_height(180)
        sc.add(self.log_view)
        content.pack_start(sc, True, True, 0)
        self.page_shell("正在安装 DUESLIN", "正在解压系统镜像并写入磁盘", content)

        th = threading.Thread(target=self.do_install, daemon=True)
        th.start()

    def do_install(self):
        def cb_pct(p):
            GLib.idle_add(self.prog.set_fraction, p / 100.0)
            GLib.idle_add(self.prog.set_text, f"{p}%")
        def cb_log(t):
            GLib.idle_add(self.append_log, t)
        try:
            # 重新创建安装器实例并传入所选磁盘（修复 disk=None 导致分区逻辑走错分支）
            self.installer = Installer(disk=self.disk, partition=self.partition)
            self.installer.install(cb_pct, cb_log)
            GLib.idle_add(self.show_page_done)
        except Exception as e:
            log(f"安装失败: {e}")
            GLib.idle_add(self.append_log, f"✗ 安装失败: {e}\n")

    def append_log(self, t):
        buf = self.log_view.get_buffer()
        buf.insert(buf.get_end_iter(), t + "\n")
        return False

    # ---------- 完成页 ----------
    def show_page_done(self):
        self.step = 4
        self.update_steps()
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        ok = Gtk.Label()
        ok.set_markup('<span font="30">✅</span>')
        t = Gtk.Label()
        t.set_markup('<span font="20" weight="bold" color="#111827">DUESLIN 安装完成！</span>')
        self.count_lb = Gtk.Label()
        self.count_lb.set_markup('<span font="14" color="#374151">电脑将在 <b>5</b> 秒后自动重启 ...</span>')
        content.pack_start(ok, False, False, 0)
        content.pack_start(t, False, False, 0)
        content.pack_start(self.count_lb, False, False, 0)

        hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        now = Gtk.Button(label="立即重启")
        now.get_style_context().add_class("primary")
        now.connect("clicked", lambda w: self.reboot())
        hb.pack_start(now, True, False, 0)
        content.pack_start(hb, False, False, 6)
        self.page_shell("安装完成", "取出安装介质，系统即将重启", content)

        self.remain = 5
        self.timer_id = GLib.timeout_add(1000, self.countdown)
        # 抽出介质提示
        self.append_done_hint()

    def append_done_hint(self):
        pass

    def countdown(self):
        self.remain -= 1
        if self.remain <= 0:
            self.reboot()
            return False
        self.count_lb.set_markup(
            f'<span font="14" color="#374151">电脑将在 <b>{self.remain}</b> 秒后自动重启 ...</span>')
        return True

    def reboot(self):
        log("触发重启")
        subprocess.Popen("reboot -f", shell=True)

    def on_close_ask(self, widget, event):
        if self.step >= 2:
            # 安装中/完成后关闭 = 询问
            dlg = Gtk.MessageDialog(
                transient_for=self, modal=True, buttons=Gtk.ButtonsType.YES_NO,
                message_format="确定要关闭安装程序吗？")
            dlg.format_secondary_text("关闭后系统将停留在安装环境，请重新启动安装介质。")
            resp = dlg.run()
            dlg.destroy()
            if resp == Gtk.ResponseType.YES:
                if self.timer_id:
                    GLib.source_remove(self.timer_id)
                Gtk.main_quit()
            return True
        Gtk.main_quit()
        return True

def main():
    w = InstallerWindow()
    w.set_css(w)
    w.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
