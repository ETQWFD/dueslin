    # ---------- 确认安装：内存检查 ----------
    def on_welcome_confirm(self, widget):
        """确认安装 → 检查内存（≥2GB）→ 进入许可协议页。"""
        total = 0
        try:
            with open("/proc/meminfo") as f:
                for l in f:
                    if l.startswith("MemTotal"):
                        total = int(l.split()[1]) // 1024
                        break
        except Exception:
            pass
        if total < 2048:
            dlg = Gtk.MessageDialog(
                transient_for=self, modal=True,
                message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.YES_NO,
                text=f"内存不足：当前 {total} MB",
                secondary_text="DUESLIN 建议至少 2GB 内存以获得流畅安装体验。\n\n是否仍然继续安装？")
            resp = dlg.run(); dlg.destroy()
            if resp != Gtk.ResponseType.YES:
                return
        self.show_page_eula()

    # ---------- 键盘支持（回车 = 当前页主按钮）----------
    def on_key(self, widget, event):
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if self.step == 0:
                self.on_welcome_confirm(None)
            elif self.step == 1:
                self.on_eula_next(None)
            elif self.step == 2:
                d = getattr(self, "_chosen_disk", None)
                if d:
                    self.on_disk_chosen(None, d)
            elif self.step == 3:
                self.start_install()
            return True
        return False

    # ---------- 许可协议页 ----------
    def show_page_eula(self):
        self.step = 1
        self.update_steps()
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card.set_margin_top(14); card.set_margin_bottom(14)
        card.set_margin_start(20); card.set_margin_end(20)
        eula = Gtk.Label()
        eula.set_line_wrap(True)
        eula.set_justify(Gtk.Justification.LEFT)
