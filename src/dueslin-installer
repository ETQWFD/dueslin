        box.pack_start(self.main, True, True, 0)

        self.installer = Installer()
        self.disk = None
        self.partition = None
        self.step = 0
        self.timer_id = None

        self.show_page_welcome()

    # ---------- 页面框架 ----------
    def clear_main(self):
        for c in self.main.get_children():
            self.main.remove(c)

    def page_shell(self, title, subtitle, content):
        self.clear_main()
        self.main.set_margin_top(36); self.main.set_margin_start(36)
        self.main.set_margin_end(36); self.main.set_margin_bottom(36)
        t = Gtk.Label()
        t.set_markup(f'<span font="24" weight="bold" color="#111827">{title}</span>')
        t.set_halign(Gtk.Align.START)
        st = Gtk.Label(label=subtitle)
        st.get_style_context().add_class("subtitle")
        st.set_halign(Gtk.Align.START)
        st.set_margin_bottom(20)
        self.main.pack_start(t, False, False, 0)
        self.main.pack_start(st, False, False, 0)
        self.main.pack_start(content, True, True, 0)
        self.main.show_all()

    def update_steps(self):
        for i, lb in enumerate(self.step_labels):
            if i < self.step:
                lb.set_markup(f'<span foreground="#22c55e" weight="bold">   {i+1}  {self.STEPS[i]}  ✓</span>')
            elif i == self.step:
                lb.set_markup(f'<span foreground="#1a73e8" weight="bold">   {i+1}  {self.STEPS[i]}</span>')
            else:
                lb.set_markup(f'<span foreground="#9ca3af">   {i+1}  {self.STEPS[i]}</span>')

    def set_css(self, widget):
        """递归应用 CSS"""
        sc = Gtk.CssProvider()
        sc.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), sc,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

