        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("delete-event", self.on_close_ask)

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.add(box)

        # 侧边栏
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        side.set_size_request(230, -1)
        side.get_style_context().add_class("sidebar")
        side.set_margin_top(32); side.set_margin_bottom(32)
        logo = Gtk.Label(label="◆", )
        logo.set_markup(f'<span font="28" foreground="{BRAND}">◆</span>')
        brand = Gtk.Label(label="DUESLIN")
        brand.set_markup(f'<span font="20" weight="bold" foreground="#111827">DUESLIN</span>')
        ver = Gtk.Label(label="安装程序 1.0")
        ver.get_style_context().add_class("subtitle")
        side.pack_start(logo, False, False, 0)
        side.pack_start(brand, False, False, 0)
        side.pack_start(ver, False, False, 10)
        self.step_labels = []
        for i, s in enumerate(self.STEPS):
            lb = Gtk.Label(label=f"   {i+1}  {s}")
            lb.set_halign(Gtk.Align.START)
            lb.set_margin_start(12)
            self.step_labels.append(lb)
            side.pack_start(lb, False, False, 6)
        box.pack_start(side, False, False, 0)

