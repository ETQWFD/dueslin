1 ICON "logo.ico"

1 VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILETYPE        0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "etc"
            VALUE "FileDescription",  "DUESLIN 系统镜像刻录器"
            VALUE "FileVersion",      "2.0.0"
            VALUE "InternalName",     "DueslinBurner"
            VALUE "LegalCopyright",   "Copyright (c) etc. All rights reserved."
            VALUE "OriginalFilename", "DueslinBurner.exe"
            VALUE "ProductName",      "DUESLIN 镜像刻录器"
            VALUE "ProductVersion",   "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

1 RT_MANIFEST "app.manifest"
