#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
DUESLIN 安装器 — 键盘操作版
按键: ↑↓=选择  n=勾选/切换  k=下一步  o=上一步  w=确定
流程: 欢迎 -> 语言 -> 许可协议 -> 磁盘选择 -> 安装(WIM解压) -> 完成(5秒自动重启)
运行环境: DUESLIN live/PE 环境（root）
"""
import os, re, sys, time, subprocess, glob, shutil

SRC_MARKER = "/run/dueslin_src"
MODE_MARKER = "/run/dueslin_mode"

def log(msg):
    print("[INSTALLER] %s" % msg, flush=True)

def run(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True)

def run_log(cmd):
    r = subprocess.run(cmd, shell=True, capture_output=True)
    out = (r.stdout.decode() + r.stderr.decode()).strip()
    if out:
        log("CMD %s | %s" % (cmd, out.replace("\n", " ")[:260]))
    return r

def _find_wim():
    """查找安装源 WIM：标记文件 -> 已挂载点 -> 强制挂载 CD（含重试）"""
    if os.path.exists(SRC_MARKER):
        with open(SRC_MARKER) as f:
            src = f.read().strip()
        if src and os.path.exists(src):
            return src
    # 已挂载点
    for cand in glob.glob("/media/*/boot/dueslin/DUESLIN.wim"):
        return cand
    # 直接解析 /proc/mounts 找 sr0 挂载点（initramfs 已挂载）
    r = run("grep -E 'sr[0-9]|cdrom' /proc/mounts 2>/dev/null | awk '{print $2}' | head -1")
    mnt = r.stdout.decode().strip() if r.stdout else ""
    if mnt:
        for cand in glob.glob(mnt + "/boot/dueslin/DUESLIN.wim") + glob.glob(mnt + "/*/boot/dueslin/DUESLIN.wim") + glob.glob(mnt + "/dueslin/DUESLIN.wim"):
            if os.path.exists(cand):
                return cand
    # 卸载 switch_root 残留挂载，重新挂载 CD 到本环境可见点
    run("umount /dev/sr0 2>/dev/null; umount /dev/sr1 2>/dev/null; umount /media/cdrom 2>/dev/null; sleep 1")
    run("modprobe sr_mod 2>/dev/null; modprobe isofs 2>/dev/null; sleep 2")
    for _ in range(6):
        os.makedirs("/media/cdrom", exist_ok=True)
        for dev in ["/dev/sr0", "/dev/sr1", "/dev/cdrom", "/dev/cdrom0"]:
            if os.path.exists(dev):
                run("mount -t iso9660 -o ro %s /media/cdrom 2>/dev/null" % dev)
        for base in ["/media", "/run", "/mnt", "/tmp"]:
            for cand in glob.glob(base + "/*/boot/dueslin/DUESLIN.wim"):
                return cand
        time.sleep(2)
    # 兜底：全盘查找（覆盖任意挂载点）
    r = run("find /media /run /mnt /tmp -maxdepth 6 -name DUESLIN.wim 2>/dev/null | head -1")
    out = r.stdout.decode().strip() if r.stdout else ""
    return out if out else None


def install_mouse(mnt, pairdir):
    """把 gpm 装进目标系统并设为开机启动：安装好的系统也自带鼠标。"""
    srcs = []
    if pairdir:
        srcs.append(os.path.join(os.path.dirname(pairdir), "gpm"))
    srcs += ["/media/cdrom/dueslin/gpm", "/run/dueslin_iso/dueslin/gpm",
             "/usr/sbin/gpm"]
    gpm = None
    for c in srcs:
        if c and os.path.exists(c):
            gpm = c
            break
    if not gpm:
        log("未找到 gpm，跳过目标系统鼠标安装")
        return
    run("mkdir -p %s/usr/sbin %s/usr/bin" % (mnt, mnt))
    run_log("cp -f %s %s/usr/sbin/gpm" % (gpm, mnt))
    run("chmod 755 %s/usr/sbin/gpm" % mnt)
    # 启动脚本：优先 imps2，失败退回 exps2
    script = """#!/bin/sh
# DUESLIN 鼠标服务：为控制台/安装环境提供指针（X 桌面下由 X 自身接管）
[ -x /usr/sbin/gpm ] || exit 0
pidof gpm >/dev/null 2>&1 && exit 0
/usr/sbin/gpm -m /dev/input/mice -t imps2 -A >/dev/null 2>&1 || \
/usr/sbin/gpm -m /dev/input/mice -t exps2 -A >/dev/null 2>&1
"""
    with open("/tmp/_dtm", "w") as f:
        f.write(script)
    run_log("cp -f /tmp/_dtm %s/usr/bin/dueslin-mouse" % mnt)
    run("chmod 755 %s/usr/bin/dueslin-mouse" % mnt)
    # inittab 追加一条 respawn（幂等：已存在则跳过）
    itab = os.path.join(mnt, "etc", "inittab")
    if os.path.exists(itab):
        txt = open(itab).read()
        if "dueslin-mouse" not in txt:
            txt += "\n# DUESLIN: 系统自带鼠标服务\n::respawn:/usr/bin/dueslin-mouse\n"
            open(itab, "w").write(txt)
            log("目标系统 inittab 已加入鼠标服务")
    log("目标系统鼠标已安装")

def list_disks():
    """扫描所有真实块设备（SATA/SCSI/NVMe/virtio/IDE/USB/MMC/RAID），
    排除光驱(rom)、内存盘(ram)、设备映射(dm)、loop、zram 等不可安装设备。"""
    disks = []
    skip = ("loop", "ram", "zram", "dm-", "md", "sr", "nbd", "fd", "wbt", "nullb")
    # 安装介质自身的设备（避免把装机 U 盘/CD 当作安装目标）
    selfdev = set()
    try:
        mnt = open("/proc/mounts").read()
        for line in mnt.splitlines():
            f = line.split()
            if len(f) > 1 and f[1] in ("/media/cdrom", "/run/dueslin_iso", "/"):
                base = os.path.basename(os.path.realpath(f[0]))
                selfdev.add(base)
                selfdev.add(os.path.basename(f[0]))
    except Exception:
        pass
    try:
        for name in sorted(os.listdir("/sys/block")):
            if name.startswith(skip):
                continue
            if name in selfdev:
                continue
            blk = "/sys/block/%s" % name
            # 可移动介质(U盘/移动硬盘)允许安装
            devnodes = glob.glob("/sys/block/%s/device/block" % name)
            dev = "/dev/%s" % name
            if not os.path.exists(dev):
                # NVMe/MMC 的设备节点在子目录里：/sys/block/nvme0n1/device
                continue
            try:
                with open("%s/size" % blk) as f:
                    secs = int(f.read().strip())
                if secs <= 0:
                    continue
            except Exception:
                pass
            # 跳过只有 <2GB 的设备（装不下系统）
            try:
                if secs * 512 < 2 * 1024 * 1024 * 1024:
                    continue
            except Exception:
                pass
            try:
                with open("%s/queue/logical_block_size" % blk) as f:
                    lbs = int(f.read().strip())
                secs = secs * 512 // (lbs or 512) if lbs and lbs != 512 else secs
            except Exception:
                pass
            if os.path.exists(blk + "/ro") :
                try:
                    if open(blk + "/ro").read().strip() == "1":
                        continue
                except Exception:
                    pass
            disks.append(dev)
    except Exception:
        pass
    # 兜底：老环境 /sys/block 不可读时按命名规则找
    if not disks:
        for pat in ["/dev/sd[a-z]", "/dev/vd[a-z]", "/dev/hd[a-z]",
                    "/dev/nvme[0-9]n[0-9]", "/dev/mmcblk[0-9]"]:
            for d in sorted(glob.glob(pat)):
                if d not in disks and os.path.exists(d):
                    disks.append(d)
    # 兜底：/sys/block 读不到时用 /proc/partitions 枚举整盘（无子分区号）
    if not disks:
        try:
            for line in open("/proc/partitions").read().splitlines()[2:]:
                f = line.split()
                if len(f) < 4:
                    continue
                name, blocks = f[3], int(f[2])
                if name[-1].isdigit() and not name.startswith("nvme"):
                    continue
                if name[-1].isdigit() and name.startswith("nvme") and "p" in name:
                    continue
                if name.startswith(skip):
                    continue
                if blocks * 1024 < 2 * 1024 * 1024 * 1024:
                    continue
                dev = "/dev/%s" % name
                if os.path.exists(dev):
                    disks.append((name, dev, blocks * 1024))
        except Exception:
            pass
    return disks

def disk_size(disk):
    try:
        with open("/sys/class/block/%s/size" % os.path.basename(disk)) as f:
            secs = int(f.read().strip())
        return "%.1f GB" % (secs * 512 / 1024 / 1024 / 1024)
    except Exception:
        return "?"

