def _auto_install(disk):
    """自动/无人值守安装（MODE_MARKER 存在时）"""
    log("auto_support=AUTO_OK")
    log("开始安装到 %s" % disk)
    run("wipefs -a %s" % disk)
    run_log("parted -s %s mklabel gpt" % disk)
    run_log("parted -s %s mkpart primary 1MiB 2MiB" % disk)
    run_log("parted -s %s set 1 bios_grub on" % disk)
    run_log("parted -s %s mkpart primary fat32 2MiB 514MiB" % disk)
    run_log("parted -s %s set 2 esp on" % disk)
    run_log("parted -s %s mkpart primary ext4 514MiB 100%%" % disk)
    run_log("partprobe %s" % disk)
