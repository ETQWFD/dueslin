""" % rootdev
    run("mkdir -p %s/boot/grub" % mnt)
    with open("%s/boot/grub/grub.cfg" % mnt, "w") as f:
        f.write(cfg)
    run("sync")
    log("安装完成")
    log("触发重启")
    os.system("reboot -f")

def main():
    import curses, sys
    mode = "auto" if (os.path.exists(MODE_MARKER) or "--auto" in sys.argv) else "gui"
    if mode == "auto":
        disks = list_disks()
        if not disks:
            log("错误: 未找到磁盘")
            return 1
        _auto_install(disks[0])
        return 0
    def _run(stdscr):
        t = TUI(stdscr)
        return t.run()
    try:
        curses.wrapper(_run)
    except Exception as e:
        log("curses 不可用: %s" % e)
        disks = list_disks()
        if disks:
            _auto_install(disks[0])

if __name__ == "__main__":
    main()
